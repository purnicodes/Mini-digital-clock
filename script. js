
function showTime() {
    let time = new Date();

    let h = String(time.getHours()).padStart(2, '0');
    let m = String(time.getMinutes()).padStart(2, '0');
    let s = String(time.getSeconds()).padStart(2, '0');

    document.getElementById("time").innerText =
        h + ":" + m + ":" + s;
}

setInterval(showTime, 1000);
showTime();
